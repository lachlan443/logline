# Webhook credentials — one set per source
SONARR_WEBHOOK_USER=sonarr
SONARR_WEBHOOK_PASS=

RADARR_WEBHOOK_USER=radarr
RADARR_WEBHOOK_PASS=

PROWLARR_WEBHOOK_USER=prowlarr
PROWLARR_WEBHOOK_PASS=

SABNZBD_WEBHOOK_USER=sabnzbd
SABNZBD_WEBHOOK_PASS=

QBITTORRENT_WEBHOOK_USER=qbittorrent
QBITTORRENT_WEBHOOK_PASS=

# Arr app URLs and API keys
SONARR_URL=http://sonarr:8989
SONARR_API_KEY=

RADARR_URL=http://radarr:7878
RADARR_API_KEY=

PROWLARR_URL=http://prowlarr:9696
PROWLARR_API_KEY=

# The URL logline registers with arr apps as the webhook target
LOGLINE_URL=http://logline:5959

# Home Assistant (for instant sensor refresh after each webhook)
HA_URL=http://homeassistant:8123
HA_TOKEN=

# SQLite database path (default: /config/logline.db)
# DB_PATH=/config/logline.db
